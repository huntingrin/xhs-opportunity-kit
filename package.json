{
  "name": "@huntingrin/xhs-opportunity-kit",
  "version": "0.1.0",
  "description": "Local-first Xiaohongshu opportunity SDK, JSON CLI, MCP server and portable agent skill.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "bin": { "xhs-opportunity": "dist/cli.js", "xhs-opportunity-mcp": "dist/mcp-server.js" },
