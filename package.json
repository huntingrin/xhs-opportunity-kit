  "files": ["dist", "skills", "examples", "docs", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/core.test.mjs tests/interfaces.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.32.1", "zod": "^3.25.76" },
  "devDependencies": { "@types/node": "^22.19.0", "typescript": "^5.9.3" },
  "repository": { "type": "git", "url": "git+https://github.com/huntingrin/xhs-opportunity-kit.git" },
